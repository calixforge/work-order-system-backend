# 复制本文件为 .env(同目录),填真实值;.env 不提交到 git
# docker compose 会自动读取同目录的 .env

# MySQL root 密码(app 以 root 连库)
MYSQL_PASSWORD=change-me-mysql

# Redis 访问密码
REDIS_PASSWORD=change-me-redis

# JWT 签名密钥,建议一段长随机串(至少 32 位)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ===== AI / RAG =====
# chat 模型密钥
AI_BASE_URL=https://your-provider.example.com
AI_API_KEY=change-me-chat-api-key
# chat 模型名
AI_CHAT_MODEL=change-me-model-name
# SiliconFlow 密钥(embedding 用 BAAI/bge-m3,端点已写死在 application-docker.yml)
AI_EMBEDDING_API_KEY=change-me-siliconflow-api-key
